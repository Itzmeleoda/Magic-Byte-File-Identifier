{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileTypeID",
  "version": "0.1.0",
  "identifier": "com.filetypeid.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FileTypeID — Magic-Byte Identifier",
        "width": 1150,
        "height": 740,
        "minWidth": 820,
        "minHeight": 520,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": []
  }
}
